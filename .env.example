# 复制为 .env 后填入你在 dev.meta.ai 创建的 API Key。不填 = 演示模式。
MODEL_API_KEY=
# 可选
# PORT=8765
# ASR_MODE=ENDPOINTING   # 或 DIARIZATION（区分说话人）
# 可选：Meta Model API（muse-spark-*）。LLM_FAST_MODEL / LLM_SUMMARY_MODEL 设成 muse-spark-1.3 即走 Meta，出错回落 NewAPI（LLM_FALLBACK_MODEL，默认 gpt-6-luna）
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# META_REASONING_EFFORT=minimal   # minimal/low/medium/high；建议回答要快用 minimal
# 每个模型的备用链（逗号分隔，出错/429/5xx/超时/空输出时依次换下一个；下面是默认值）
# LLM_TRANSLATE_FALLBACK=groq-gpt-120b,gpt-6-luna,local-llm
# LLM_FAST_FALLBACK=groq-gpt-120b,gpt-6-luna,local-llm
# LLM_SUMMARY_FALLBACK=gpt-6-luna,groq-qwen-27b,groq-gpt-120b
# 每一步的超时秒数（按 主模型,备用1,备用2… 的顺序；下面是默认值）
# LLM_TRANSLATE_TIMEOUTS=2,2,3,5
# LLM_FAST_TIMEOUTS=3,3,4,8
# LLM_SUMMARY_TIMEOUTS=15,20,10,15
# LLM_COOLDOWN_S=20   # 刚失败的模型冷却几秒，期间直接走下一个（groq-* 两个都 429 会一起冷却）
